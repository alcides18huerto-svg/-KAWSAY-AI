# ============================================================================
# KAWSAY AI — Variables de entorno centralizadas (entorno local)
#
#   - El BACKEND local lee "backend/.env" (pydantic-settings: env_file=".env").
#   - Docker Compose usa backend/docker-compose.yml (valores con defaults).
#   - La Web lee "apps/*/.env" (VITE_API_URL).
# Copia este archivo donde corresponda y ajusta los valores. Referencia:
#   - backend/app/core/config.py
#   - backend/docker-compose.yml
# ============================================================================

# ----------------------------- App / Backend --------------------------------
APP_ENV=development
API_PORT=8000
DATABASE_URL=postgresql+psycopg://kawsay:kawsay@localhost:5432/kawsay
JWT_SECRET=development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
REQUEST_TIMEOUT_SECONDS=30.0
LOG_LEVEL=INFO

# ----------------------------- PostgreSQL 16 ---------------------------------
POSTGRES_DB=kawsay
POSTGRES_USER=kawsay
POSTGRES_PASSWORD=kawsay
POSTGRES_PORT=5432

# ----------------------------- pgAdmin (opcional) ----------------------------
PGADMIN_EMAIL=admin@kawsay.local
PGADMIN_PASSWORD=kawsay
PGADMIN_PORT=5050

# ----------------------------- AI Gateway -------------------------------------
# AI_PROVIDER: "mock" (fallback heurístico, sin llamadas externas) | "openai"
AI_PROVIDER=mock
AI_API_KEY=

# ----------------------------- Web (Vite) -------------------------------------
# Teacher-Web -> 5173 | Admin-Web -> 5174 (definidos en CORS_ORIGINS)
TEACHER_WEB_PORT=5173
ADMIN_WEB_PORT=5174