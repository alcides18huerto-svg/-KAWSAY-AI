# ============================================================================
# KAWSAY AI — .gitignore (raíz)
# Cubre Backend (Python), Frontend (Node/Vite), Mobile (Flutter) y Docker.
# ============================================================================

# ------------------------------- Entorno / secretos --------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ------------------------------- Python / Backend ----------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
venv/
.venv/
*.egg-info/
build/backend/

# ------------------------------- Node / Frontend -----------------------------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.eslintcache
.prettiercache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
# Salida de tsc -b (vite.config.ts compilado en las apps Web)
frontend-web/*/vite.config.js
frontend-web/*/vite.config.d.ts

# ------------------------------- Flutter / Mobile ----------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml
# NOTA: en apps de Flutter se recomienda versionar pubspec.lock (apps libraries)

# ------------------------------- Logs / temporales ---------------------------
*.log
*.out
*.err
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------- QA / cobertura ------------------------------
coverage/
junit.xml

# ------------------------------- Comprimidos / backups -----------------------
*.zip
*.rar
*.7z

# ------------------------------- Editores / IDE ------------------------------
.idea/
.vscode/
project/

# ------------------------------- Docker --------------------------------------
# Los volúmenes y credenciales se gestionan fuera del repo (ver .env.example).